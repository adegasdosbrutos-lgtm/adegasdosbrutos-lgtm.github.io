rules_version = '2';
// Regras do Firebase da Adega dos Brutos (Firestore > Regras).
// Dono = conta Google da adega. Cliente só lê e escreve depois que o dono aprovar.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function dono() {
      return logado() && request.auth.token.email == 'adegasdosbrutos@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function caminhoAcesso() { return /databases/$(database)/documents/acessos/$(request.auth.uid); }
    function aprovado() {
      return logado() && exists(caminhoAcesso()) && get(caminhoAcesso()).data.status == 'aprovado';
    }
    function liberado() { return dono() || aprovado(); }
    function texto(t, max) { return t is string && t.size() <= max; }
    // nome que aparece na mensagem: o do cadastro (cliente) ou qualquer um curto (dono)
    function nomeCerto(n) { return dono() ? (n is string && n.size() > 0 && n.size() <= 60) : n == get(caminhoAcesso()).data.nome; }

    // pedidos de acesso: um por conta Google (id = uid)
    match /acessos/{uid} {
      allow get: if dono() || (logado() && request.auth.uid == uid);
      allow list: if dono();
      allow create: if logado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'whatsapp', 'email', 'foto', 'status', 'criadoEm'])
        && request.resource.data.keys().hasAll(['nome', 'whatsapp', 'status', 'criadoEm'])
        && request.resource.data.status == 'pendente'
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 40
        && request.resource.data.whatsapp is string && request.resource.data.whatsapp.matches('[0-9]{10,11}')
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email)
        && (!('foto' in request.resource.data) || texto(request.resource.data.foto, 500))
        && request.resource.data.criadoEm == request.time;
      allow update: if dono()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decididoEm'])
        && request.resource.data.status in ['pendente', 'aprovado', 'recusado', 'bloqueado'];
      // o cliente pode apagar o próprio cadastro, menos quando está bloqueado
      allow delete: if dono() || (logado() && request.auth.uid == uid && resource.data.status != 'bloqueado');
    }

    // bate-papo: uma sala só
    match /chat/{id} {
      allow read: if liberado();
      allow create: if liberado()
        && request.resource.data.keys().hasOnly(['texto', 'foto', 'uid', 'nome', 'dono', 'criadoEm'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.dono == dono()
        && request.resource.data.criadoEm == request.time
        && nomeCerto(request.resource.data.nome)
        && texto(request.resource.data.texto, 500)
        && (request.resource.data.texto.size() > 0 || 'foto' in request.resource.data)
        && (!('foto' in request.resource.data) || (request.resource.data.foto is string
            && request.resource.data.foto.size() < 400000
            && request.resource.data.foto.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')));
      allow delete: if dono() || (logado() && resource.data.uid == request.auth.uid);
    }

    // curtidas e comentários dos vídeos (os vídeos em si ficam no GitHub)
    match /videos/{vid}/curtidas/{uid} {
      allow read: if liberado();
      allow create: if liberado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['criadoEm'])
        && request.resource.data.criadoEm == request.time;
      allow delete: if dono() || (logado() && request.auth.uid == uid);
    }
    match /videos/{vid}/comentarios/{id} {
      allow read: if liberado();
      allow create: if liberado()
        && request.resource.data.keys().hasOnly(['texto', 'uid', 'nome', 'dono', 'criadoEm'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.dono == dono()
        && request.resource.data.criadoEm == request.time
        && nomeCerto(request.resource.data.nome)
        && texto(request.resource.data.texto, 300) && request.resource.data.texto.size() > 0;
      allow delete: if dono() || (logado() && resource.data.uid == request.auth.uid);
    }
  }
}
